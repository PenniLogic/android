  "local_events": {
    "privacy_payload_refused": {
      "category": "local_log",
      "fields": {
        "event": {"kind": "enum", "values": ["privacy_payload_refused"], "nullable": false},
        "code": {
          "kind": "enum",
          "values": ["malformed_document", "duplicate_json_key", "document_size_refused", "document_complexity_refused", "document_object_required", "numeric_value_refused", "non_finite_json", "invalid_policy", "required_journey_drift", "capture_budget_drift", "invalid_component_registry", "payload_schema_overlap", "payload_category_drift", "analytics_route_drift", "invalid_payload_schema", "invalid_field_rule", "invalid_journey_provider", "invalid_destination_registry", "invalid_host_metadata_registry", "invalid_route", "duplicate_route", "device_only_schema_refused", "unsafe_analytics_schema", "undeclared_payload_schema", "undeclared_payload_field", "payload_value_refused", "undeclared_route", "device_only_artifact_egress", "source_event_origin_unverified", "monetary_analytics"],
          "nullable": false
        }
      }
    },
    "app_start": {
      "category": "local_log",
      "fields": {
        "event": {"kind": "enum", "values": ["app_start"], "nullable": false},
        "build_type": {"kind": "enum", "values": ["debug", "release"], "nullable": false},
        "version_name": {"kind": "pattern", "pattern": "[0-9]+\\.[0-9]+\\.[0-9]+(-debug)?", "max_length": 32, "nullable": false},
        "version_code": {"kind": "integer", "minimum": 1, "maximum": 2147483647, "nullable": false},
        "configuration": {"kind": "enum", "values": ["loaded", "invalid"], "nullable": false},
        "problems": {
          "kind": "array",
          "max_items": 6,
          "nullable": false,
          "items": {
            "kind": "enum",
            "values": ["PENNILOGIC_ENVIRONMENT:missing", "PENNILOGIC_ENVIRONMENT:invalid", "PENNILOGIC_API_BASE_URL:missing", "PENNILOGIC_API_BASE_URL:invalid", "PENNILOGIC_BUILD_LABEL:missing", "PENNILOGIC_BUILD_LABEL:invalid"],
            "nullable": false
          }
        }
      }
    },
    "capture_health": {
      "category": "local_log",
      "fields": {
        "event": {"kind": "enum", "values": ["capture_health"], "nullable": false},
        "api_level": {"kind": "integer", "minimum": 26, "maximum": 100, "nullable": false},
        "target_api": {"kind": "integer", "minimum": 36, "maximum": 36, "nullable": false},
        "stop_reason": {"kind": "enum", "values": ["undefined", "cancelled_by_app", "preempt", "timeout", "device_state", "constraint_battery_not_low", "constraint_charging", "constraint_connectivity", "constraint_device_idle", "constraint_storage_not_low", "quota", "background_restriction", "app_standby", "user", "system_processing", "estimated_app_launch_time_changed", "timeout_abandoned", "not_stopped", "unknown"], "nullable": true},
        "standby_bucket": {"kind": "enum", "values": ["active", "working_set", "frequent", "rare", "restricted", "unknown"], "nullable": true},
        "standby_bucket_raw": {"kind": "integer", "minimum": -2147483648, "maximum": 2147483647, "nullable": true},
        "capture_health": {"kind": "enum", "values": ["healthy", "paused", "blocked"], "nullable": true},
        "condition": {"kind": "enum", "values": ["capture_paused_by_platform", "capture_blocked_by_setting", "device_permission_not_granted"], "nullable": true},
        "reason": {"kind": "enum", "values": ["force_stopped", "private_space_paused", "standby_bucket_restricted", "background_restricted", "listener_access_not_granted", "restricted_setting_locked", "capture_permission_not_granted"], "nullable": true}
      }
    }
  }
